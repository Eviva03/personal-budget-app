# Public Neon base URL only. Never put a DATABASE_URL, password, or API key in browser variables.
VITE_NEON_URL=https://YOUR_NEON_HOST/your_database
# Alternatively, Vercel's Neon integration provides this public Auth URL.
# VITE_NEON_AUTH_URL=https://YOUR_NEON_AUTH_HOST/your_database/auth

# Same public Neon base URL, used by Vercel API handlers to derive the Data API endpoint.
NEON_URL=https://YOUR_NEON_HOST/your_database
# Alternatively, Vercel's Neon integration provides NEON_AUTH_BASE_URL.